# The PRODUCTION stack's environment, copied to /opt/tic-campus/.env by hand at
# install time and never written by the application (DEPLOY-CONVENTIONS.md §4).
# Root owns it, 0600. It is gitignored; this template is not.
#
# Generate both role passwords with `openssl rand -hex 32`, not `-base64`.
# Measured in MEV against pg-connection-string@2.x, which is what parses
# DATABASE_URL: a '/', '?' or '#' throws `Invalid URL`, and a '%XX' sequence is
# silently percent-DECODED into a different byte. Hex avoids the question.

NODE_ENV=production
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
# tic-platform's shared instance, reached over the `tic-db` network. Note the
# database is `tic_auth`, not `campus` — this stack gets a SCHEMA in it, not a
# database of its own.
#
# `campus_svc` is the runtime role: a member of `campus_app`, which holds SELECT
# on `directory.*` and, from the first migration on, DML on `campus`. It holds
# no CREATE anywhere. Migrations run separately as `campus_owner`, from the
# host, and that password never enters this file or a container.
#
# No password in the URL: it is read from the mounted secret below, because a
# password with the wrong byte in it breaks URL parsing before the database is
# ever reached.
DATABASE_URL=postgresql://campus_svc@tic-db:5432/tic_auth
DATABASE_PASSWORD_FILE=/run/secrets/db_svc_password

# ── tic-auth ─────────────────────────────────────────────────────────────────
# Campus is a CONFIDENTIAL tic-auth client (F3, tic-auth/docs/CLIENTS.md): the
# browser only ever talks to this origin, and the code exchange happens here.
#
# Two base URLs, and they are not interchangeable. TIC_AUTH_ISSUER is where a
# person's BROWSER goes — /authorize and /logout — and it is also the `iss` this
# process asserts byte for byte. Everything this PROCESS calls goes to
# http://tic-proxy instead, because https://tic-auth.ort.edu.ar does not resolve
# from inside the VM at all: both FortiWeb addresses time out (medido
# 2026-09-05).
#
# The Host header below is load-bearing and FAILS SOFT: omit it and nginx's
# default server answers 200 with the wrong body, so the first symptom is a JSON
# parse error several layers from the cause. That is why `make smoke` and the
# doctor assert a `kid` and never a status.
TIC_AUTH_ISSUER=https://tic-auth.ort.edu.ar
TIC_AUTH_INTERNAL_BASE_URL=http://tic-proxy
TIC_AUTH_JWKS_URL=http://tic-proxy/.well-known/jwks.json
TIC_AUTH_JWKS_HOST_HEADER=tic-auth.ort.edu.ar

TIC_AUTH_CLIENT_ID=tic-campus
TIC_AUTH_AUDIENCE=tic-campus

# STATIC, never derived from the request. nginx terminates at `listen 80` behind
# two proxies, so a scheme read off a request is `http` on a page the browser
# loaded over TLS — and tic-auth matches this byte for byte, so `http` here is an
# error page instead of a callback. A trailing slash is a different URI.
# `manage_clients check-redirect` prints the first differing character.
TIC_AUTH_REDIRECT_URI=https://tic-campus.ort.edu.ar/api/auth/callback

# The client secret, mounted as a file like the database password so it is not in
# `docker inspect`. Issued once by `manage_clients issue-secret` — see the
# README, "El login". Without it the four /api/auth/* routes do not exist (404)
# and in production the container refuses to boot.
TIC_AUTH_CLIENT_SECRET_FILE=/run/secrets/tic_auth_client_secret

# How long a campus session may last (12 h, the SSO session's own life); how
# stale its claims may get before the next request renews them (840 = 900 − 60,
# the access token's life less one clock-skew allowance); and how long to serve
# cached claims after tic-auth could not be reached. The last one is why a
# tic-auth restart is an outage rather than a school-wide logout.
SESSION_TTL_SECONDS=43200
CLAIMS_MAX_AGE_SECONDS=840
REFRESH_RETRY_SECONDS=60
