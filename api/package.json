{
  "name": "tic-campus-api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "pnpm build && node --test test/*.test.mjs",
    "db:stubs:generate": "node scripts/gen-directory-standins.mjs",
    "db:stubs:check": "node scripts/gen-directory-standins.mjs --check",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "pg": "^8.16.3",
    "pg-connection-string": "^2.9.1",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.10"
  }
}
